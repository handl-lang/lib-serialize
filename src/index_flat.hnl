--- `serialize.serialize` / `serialize.deserialize` — pure-Handl format dispatch.
--- The format arg is a string ("json", "yaml", "toml") or a serializer
--- object { type: "serializer", name: <fmt>, serialize, deserialize } —
--- produced by `toml()`/`yaml()` below (or any backend exposing the same
--- arrow-field shape, like `encoding`'s codec dispatch).
---
--- Transitional: json impl imported by path until kits wire `json` as a
--- module into loaded packages.
from "json" import stringify
from "json" import parse
from "typeof" import * as typeof

fmt_name := (f) ~> if typeof.is(f, typeof.str()) { f } else { f.name }

export serialize := (v, fmt) ~> do {
  if typeof.is(fmt, typeof.str()) {
    if fmt == "json" { stringify(v) } else {
      throw "serialize.serialize: unsupported format " + fmt
    }
  } else {
    (fmt.serialize)(v)
  }
}

export deserialize := (s, fmt) ~> do {
  if typeof.is(fmt, typeof.str()) {
    if fmt == "json" { parse(s) } else {
      throw "serialize.deserialize: unsupported format " + fmt
    }
  } else {
    (fmt.deserialize)(s)
  }
}

--- Serializer producers: records carrying the native `-c` backend's
--- serialize/deserialize arrows. `serialize.serialize(v, toml())` calls
--- `toml_c.serialize(v)`; likewise for `yaml()` -> `yaml_c.*`.
export toml := () ~> ({ type: "serializer", name: "toml", serialize: (v) ~> toml_c.serialize(v), deserialize: (s) ~> toml_c.deserialize(s) })
export yaml := () ~> ({ type: "serializer", name: "yaml", serialize: (v) ~> yaml_c.serialize(v), deserialize: (s) ~> yaml_c.deserialize(s) })

--- serialize -- generic serialization to/from strings for the handl runtime.
---
--- Contract surface for the `serialize` stdlib interface: 2 functions
--- covering serialization of `serde_json::Value` to a string (json/yaml/toml)
--- and deserialization of a string back into a `Value`. The `cap`/`op`/
--- `handle` decls below declare the capability and signature surface;
--- `plugin-lib-stdlib`'s `serialize` `ModuleSpec` loads this file via
--- `include_str!` and the `cap` lines feed the plugin capability surface.
---
--- The functions are pure `.hnl` — serializer/codec dispatch is a
--- field-call on the format record (`toml`/`yaml` below, backed by the
--- `toml_c`/`yaml_c` native modules); there is no `SerializerRegistry`
--- or `ops.rs` impl (that path is gone).
---
--- ## Capability declarations (ADR-0077 Phase 4)
--- serialize.serialize -- serialize a value into a string using a named format.
--- serialize.deserialize -- deserialize a string into a value using a named format.
cap "serialize.serialize"
cap "serialize.deserialize"
op "serialize.serialize" : (Value * Value) ~> String
  guarantee: True
op "serialize.deserialize" : (String * Value) ~> Value
  guarantee: True
handle "serialize.serialize" with serialize
handle "serialize.deserialize" with deserialize

--- pure-handl impls:
